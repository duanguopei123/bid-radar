# ---- LLM（OpenAI 兼容协议）----
# 模型名 / base_url / api_key 全部走环境变量，禁止硬编码到代码或 config.yaml
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
# 说明：LLM_API_KEY 留空时，摘要与匹配理由自动降级为本地模板生成，
#       run-once 在完全离线环境下也能产出简报文件。

# ---- 推送渠道（推荐用「工作台设置」软件填写，不用手改这里）----
# NOTIFIER_CHANNEL 可选值：
#   none           只生成网页简报，不外发（默认，最安全）
#   serverchan     微信 · Server酱（sct.ftqq.com 微信扫码登录，免费 5 条/天，无需实名）
#   pushplus       微信 · PushPlus（pushplus.plus 扫码 + 实名，200 条/天）
#   wecom_webhook  企业微信群机器人（消息到企业微信 App，不是个人微信）
NOTIFIER_CHANNEL=none

# Server酱 SendKey（SCT 或 sctp 开头），从 sct.ftqq.com 的 SendKey 页面复制
SERVERCHAN_SENDKEY=

# PushPlus token，从 pushplus.plus 一对一推送页面复制
PUSHPLUS_TOKEN=

# 企业微信群机器人 webhook 地址
WECOM_WEBHOOK_URL=

# ---- 调度（可选，覆盖 config.yaml）----
TZ=Asia/Shanghai
