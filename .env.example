# ---- LLM（OpenAI 兼容协议）----
# 模型名 / base_url / api_key 全部走环境变量，禁止硬编码到代码或 config.yaml
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
# 说明：LLM_API_KEY 留空时，摘要与匹配理由自动降级为本地模板生成，
#       run-once 在完全离线环境下也能产出简报文件。

# ---- 通知器（企业微信机器人 webhook）----
# 在企微群 -> 群机器人 -> 添加机器人 -> 复制 Webhook 地址填入下方
# 留空时：run-once 只生成本地简报文件，不实际对外发送消息（只读 MVP 安全默认）
WECOM_WEBHOOK_URL=

# ---- 调度（可选，覆盖 config.yaml）----
TZ=Asia/Shanghai
